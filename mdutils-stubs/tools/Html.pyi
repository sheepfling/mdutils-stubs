class Html:
    @staticmethod
    def paragraph(text: str, align: str | None = None) -> str: ...
    @classmethod
    def image(cls, path: str, size: str | None = None, align: str | None = None) -> str: ...

class HtmlSize:
    @classmethod
    def size_to_width_and_height(cls, size: str) -> str: ...

class SizeBadFormat(Exception):
    def __init__(self, message: str) -> None: ...
