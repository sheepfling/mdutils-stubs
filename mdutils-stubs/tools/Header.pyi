from enum import Enum

class AtxHeaderLevel(Enum):
    TITLE = ...
    HEADING = ...
    SUBHEADING = ...
    SUBSUBHEADING = ...
    MINORHEADING = ...
    LEASTHEADING = ...

class SetextHeaderLevel(Enum):
    TITLE = ...
    HEADING = ...

class HeaderStyle(Enum):
    ATX = ...
    SETEXT = ...

class Header:
    level: int
    title: str
    style: HeaderStyle
    header_id: str | None

    def __init__(
        self, level: int, title: str, style: HeaderStyle, header_id: str | None = None
    ) -> None: ...
    def __str__(self) -> str: ...
    @staticmethod
    def atx(level: AtxHeaderLevel, title: str, header_id: str | None = None) -> str: ...
    @staticmethod
    def setext(level: SetextHeaderLevel, title: str) -> str: ...
    @staticmethod
    def header_anchor(text: str, link: str | None = None) -> str: ...
    @staticmethod
    def choose_header(level: int, title: str, style: str = "atx", header_id: str = "") -> str: ...
